# Copy to .env.local and fill in your values.

# Resend API key — enables real email delivery from the contact form.
# Without it, the form runs in demo mode.
RESEND_API_KEY=

# Verified "from" address used for outgoing messages.
# Defaults to Resend's onboarding address if unset.
RESEND_EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Where contact messages are delivered. Defaults to SITE.email in lib/data.tsx.
CONTACT_EMAIL=

# Production URL, used for SEO metadata (sitemap, robots, Open Graph).
# Defaults to https://gebrye-portfolio.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=
